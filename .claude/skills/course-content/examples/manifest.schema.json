{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course lesson coverage manifest",
  "type": "object",
  "required": [
    "coverage",
    "required_figures",
    "required_components",
    "protected_images"
  ],
  "anyOf": [
    {
      "required": [
        "source_url"
      ]
    },
    {
      "required": [
        "source_path"
      ]
    }
  ],
  "properties": {
    "source_url": {
      "type": "string"
    },
    "source_path": {
      "type": "string"
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_item",
          "status",
          "reviewed",
          "review_note"
        ],
        "properties": {
          "source_item": {
            "type": "string"
          },
          "output_anchor": {
            "type": "string"
          },
          "status": {
            "enum": [
              "preserved",
              "expanded",
              "authorized_omission"
            ]
          },
          "reviewed": {
            "const": true
          },
          "review_note": {
            "type": "string",
            "minLength": 20
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authorization": {
            "type": "string"
          }
        }
      }
    },
    "required_figures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "stepper",
              "comparison"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "protected_images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "sha256"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "word_limit": {
      "type": "integer",
      "minimum": 1
    },
    "word_limit_authorization": {
      "type": "string"
    }
  }
}
